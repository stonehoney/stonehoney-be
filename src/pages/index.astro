---
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import QuickQuestions from '../components/QuickQuestions.astro';
import ChatInterface from '../components/ChatInterface.astro';
import BeeQuiz from '../components/BeeQuiz.astro';
import SeasonalCalendar from '../components/SeasonalCalendar.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>StoneHoney — Beekeeping Q&A</title>
  <meta name="description" content="Ask a master beekeeper anything. Practical answers on hive health, varroa, swarm prevention, seasonal care, and honey harvest." />
  <meta property="og:title" content="StoneHoney — Ask a Master Beekeeper" />
  <meta property="og:description" content="Practical beekeeping answers powered by 20+ years of hive experience." />
  <meta property="og:type" content="website" />
</head>
<body class="bg-white text-gray-900">
  <Hero />
  <QuickQuestions />
  <ChatInterface />
  <BeeQuiz />
  <SeasonalCalendar />
</body>
</html>
